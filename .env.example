# Local API
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Postgres — pick one. ./run.sh starts Homebrew Postgres when Docker is missing.
POSTGRES_PASSWORD=ballot_local_dev

# Homebrew postgresql@16 (no Docker):
DATABASE_URL=postgresql://ballot:ballot_local_dev@127.0.0.1:5432/ballot

# Docker Compose db (published on loopback 5433):
# DATABASE_URL=postgresql://ballot:ballot_local_dev@127.0.0.1:5433/ballot

# Remote VPS db is loopback-only. Tunnel, then point DATABASE_URL at 5433:
#   ssh -L 5433:127.0.0.1:5433 ubuntu@139.99.135.121
# DATABASE_URL=postgresql://ballot:YOUR_VPS_PASSWORD@127.0.0.1:5433/ballot

# DATA_DIR=/data
# STORAGE_DIR=/data/storage
